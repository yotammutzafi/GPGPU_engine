#version 450

layout(std140, binding = 0) buffer ParticleSSBOIn {
   int particlesIn[ ];
};

//gl_LocalInvocationID.x The ID inside the thread block(resets to 0 for every block).
//gl_GlobalInvocationID.x The ID in general (across all blocks).0 to (Total Threads - 1).

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() 
{
//Warning: you cant you particlesIn.length() because of the"Last Element Restriction"

  if(gl_GlobalInvocationID.x>=particlesIn.length())
  return;
particlesIn[gl_GlobalInvocationID.x] = particlesIn[gl_GlobalInvocationID.x]*2;

}